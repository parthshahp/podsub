{
  "name": "@podsub/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @podsub/schemas build && vite",
    "build": "pnpm --filter @podsub/schemas build && vite build && node scripts/build-pwa.mjs",
    "test": "pnpm --filter @podsub/schemas build && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @podsub/schemas build && tsc --noEmit"
  },
  "dependencies": {
    "@pinyin-pro/data": "^1.3.1",
    "@podsub/schemas": "workspace:*",
    "@tanstack/react-router": "^1.170.32",
    "hono": "^4.13.7",
    "pinyin-pro": "^3.29.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@podsub/server": "workspace:*",
    "@react-scan/vite-plugin-react-scan": "^0.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "daisyui": "^5.7.28",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.4"
  }
}
