{
  "name": "@podsub/server",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "build:dict": "tsx scripts/build-dict.ts",
    "rebuild:search": "tsx scripts/rebuild-transcript-search.ts",
    "dev": "pnpm --filter @podsub/schemas build && tsx watch src/index.ts",
    "build": "pnpm --filter @podsub/schemas build && tsc",
    "start": "node dist/index.js",
    "test": "pnpm --filter @podsub/schemas build && node --test tests/*.test.mjs",
    "typecheck": "pnpm --filter @podsub/schemas build && tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/jieba": "^2.0.2",
    "@podsub/schemas": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.7",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
