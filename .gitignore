# dev
.yarn/
!.yarn/releases
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# deps
node_modules/

# build output
dist/
*.tsbuildinfo

# Vite dev-server dependency cache (regenerated by `pnpm dev`)
.vite/

# TanStack Router generates this at dev/build time
web/src/routeTree.gen.ts

# generated from CC-CEDICT by `pnpm --filter @podsub/server build:dict`
web/public/zh-dict.json

# generated transcripts (re-transcribing costs API money; remove this line
# if you'd rather commit them so deploys don't re-pay)
podcasts/*.transcript.json

# podcast audio (large binaries; keep local or use git-lfs if you want them
# versioned)
podcasts/*.mp3
podcasts/*.m4a
podcasts/*.ogg
podcasts/*.oga
podcasts/*.wav
podcasts/*.bin
podcasts/*.part

# env
.env
.env.production

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# misc
.DS_Store

# sqlite database files (migrations in server/data/ stay committed)
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

